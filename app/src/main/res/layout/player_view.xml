<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView instead of the default SurfaceView: some TV SoCs (e.g. MStar-based Toshiba/Hisense)
     render SurfaceView video on a hardware plane that the Compose window covers, giving audio with a
     black picture. A TextureView is composited into the window itself, so it always shows. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
